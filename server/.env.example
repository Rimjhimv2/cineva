PORT=4000
# Use your own PostgreSQL user/password. With the bundled docker-compose.yml this is exactly:
DATABASE_URL=postgresql://cineva:cineva@localhost:5432/cineva
# Separate database used ONLY by `npm test` (it is wiped on every run). Its name must contain "test".
TEST_DATABASE_URL=postgresql://cineva:cineva@localhost:5432/cineva_test
# Generate your own:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
